#!/usr/bin/env bash
# Read-only client: unlimited terminals can display the same snapshot.
CACHE="/run/augustus-temp/snapshot"
MAX_AGE="${AUGUSTUS_MAX_AGE:-45}"

if [[ "${1:-}" == "--help" ]]; then
    echo "Usage: augustus-temp"
    echo "       augustus-watch  # watch with a 24-hour limit"
    exit 0
fi

if [[ ! -s "$CACHE" || ! -r "$CACHE" ]]; then
    echo "AUGUSTUS HARDWARE MONITOR"
    echo "Noch keine Messwerte. Collector-Status:"
    systemctl is-active augustus-temp-collector.timer 2>/dev/null || true
    echo "Prüfen: systemctl status augustus-temp-collector.timer"
    exit 1
fi

cat "$CACHE"

timestamp=$(stat -c %Y "$CACHE" 2>/dev/null) || exit 0
now=$(date +%s)
age=$((now - timestamp))
if (( age < 0 )); then age=0; fi
if (( age > MAX_AGE )); then
    printf '\033[33mWARNUNG: Messwerte sind %s Sekunden alt (Collector prüfen).\033[0m\n' "$age"
fi
